// Karkain Analytics Studio - first functional slice.
// Loads a numeric dataset with a header from a delimited file, computes real
// SUM/AVG aggregates over a numeric column, and prints a report. Datasets are
// stored in data/state.dat as:
//   name|rows|cols|header|r1c1,r1c2;...
// Measures are stored as records beginning with "@m":
//   @m|name|SUM|col|value
// Commands come from data/commands.dat; the rendered report is written to
// data/report.dat. Builtins only; relative paths only.

func find_dataset(state, name) {
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == name) { return state[i] }
        i = i + 1
    }
    return ""
}

func put_dataset(state, name, rows, cols, header, data) {
    let rec = name + "|" + str(rows) + "|" + str(cols) + "|" + header + "|" + data
    let out = []
    let j = 0
    let replaced = 0
    while (j < len(state)) {
        let f = split(state[j], "|")
        if (f[0] == name) { push(out, rec); replaced = 1 } else { push(out, state[j]) }
        j = j + 1
    }
    if (replaced == 0) { push(out, rec) }
    return out
}

// Reads a delimited file whose first non-empty line is a header. Returns
// "rows|cols|header|data" with rows separated by ';' and cells by ','.
func read_dataset(file) {
    let lines = split(readFile(file), "\n")
    let header = ""
    let cols = 0
    let data = ""
    let nrows = 0
    let first = 1
    let i = 0
    while (i < len(lines)) {
        let line = trim(lines[i])
        if (line != "") {
            if (first == 1) {
                header = line
                cols = len(split(line, ","))
                first = 0
            } else {
                let cells = split(line, ",")
                let row = ""
                let c = 0
                while (c < len(cells)) {
                    if (c > 0) { row = row + "," }
                    row = row + trim(cells[c])
                    c = c + 1
                }
                if (nrows > 0) { data = data + ";" }
                data = data + row
                nrows = nrows + 1
            }
        }
        i = i + 1
    }
    if (nrows == 0) { data = "EMPTY" }
    return str(nrows) + "|" + str(cols) + "|" + header + "|" + data
}

func compute_aggregate(state, name, op, colstr) {
    let rec = find_dataset(state, name)
    if (rec == "") { print("ERROR unknown dataset " + name); return state }
    let d = split(rec, "|")
    let col = int(colstr)
    let sum = 0
    let n = 0
    if (d[4] != "EMPTY") {
        let rows = split(d[4], ";")
        let i = 0
        while (i < len(rows)) {
            let cells = split(rows[i], ",")
            if (col < len(cells)) { sum = sum + int(cells[col]) }
            n = n + 1
            i = i + 1
        }
    }
    let value = ""
    if (op == "SUM") {
        value = str(sum)
    } else {
        let count = n
        if (count == 0) { count = 1 }
        let scaled = sum * 10 / count
        let whole = scaled / 10
        let frac = scaled - whole * 10
        value = str(whole) + "." + str(frac)
    }
    let mrec = "@m|" + name + "|" + op + "|" + colstr + "|" + value
    let out = []
    let replaced = 0
    let j = 0
    while (j < len(state)) {
        let mm = split(state[j], "|")
        if (mm[0] == "@m" && mm[1] == name && mm[2] == op && mm[3] == colstr) { push(out, mrec); replaced = 1 } else { push(out, state[j]) }
        j = j + 1
    }
    if (replaced == 0) { push(out, mrec) }
    print("MEASURE " + name + " " + op + " col=" + colstr + " value=" + value)
    return out
}

func report_dataset(state, name) {
    let rec = find_dataset(state, name)
    if (rec == "") { print("ERROR unknown dataset " + name); return "" }
    let d = split(rec, "|")
    let text = "REPORT " + name + "\n"
    text = text + "DATASET " + name + " rows=" + d[1] + " cols=" + d[2] + " header=" + d[3] + "\n"
    let i = 0
    while (i < len(state)) {
        let mm = split(state[i], "|")
        if (mm[0] == "@m" && mm[1] == name) {
            text = text + "MEASURE " + mm[2] + " col=" + mm[3] + " value=" + mm[4] + "\n"
        }
        i = i + 1
    }
    text = text + "REPORT_END " + name + "\n"
    print(text)
    return text
}

func persist(path, lines) {
    let out = ""
    let i = 0
    while (i < len(lines)) {
        out = out + lines[i] + "\n"
        i = i + 1
    }
    writeFile(path, out)
}

func main() {
    let cmds = split(readFile("data/commands.dat"), "\n")
    let state = split(readFile("data/state.dat"), "\n")
    let report = ""
    let i = 0
    while (i < len(cmds)) {
        let line = trim(cmds[i])
        if (line != "") {
            let f = split(line, "|")
            let op = f[0]
            if (op == "LOAD") {
                let body = read_dataset(f[2])
                let b = split(body, "|")
                state = put_dataset(state, f[1], int(b[0]), int(b[1]), b[2], b[3])
                let msg = "LOAD " + f[1] + " rows=" + b[0] + " cols=" + b[1]
                print(msg)
                report = report + msg + "\n"
            }
            if (op == "MEASURE") {
                state = compute_aggregate(state, f[1], f[2], f[3])
            }
            if (op == "REPORT") {
                report = report + report_dataset(state, f[1])
            }
        }
        i = i + 1
    }
    persist("data/state.dat", state)
    persist("data/report.dat", split(report, "\n"))
    let nd = 0
    let nm = 0
    let j = 0
    while (j < len(state)) {
        let f = split(state[j], "|")
        if (f[0] == "@m") { nm = nm + 1 } else { nd = nd + 1 }
        j = j + 1
    }
    print("ANALYTICS_STUDIO_OK datasets=" + str(nd) + " measures=" + str(nm))
}
