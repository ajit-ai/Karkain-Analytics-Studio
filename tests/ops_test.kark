// Round 2 self-contained tests for grouping, WHERE and statistics.

func test_group_aggregation() {
    let rows = "1,eng,88,eng;2,sales,72,sales;3,eng,95,eng;5,eng,80,eng"
    let rl = split(rows, ";")
    let keys = []
    let sums = []
    let counts = []
    let i = 0
    while (i < len(rl)) {
        let cells = split(rl[i], ",")
        let key = cells[1]
        let idx = -1
        let k = 0
        while (k < len(keys)) {
            if (keys[k] == key) { idx = k }
            k = k + 1
        }
        if (idx == -1) {
            push(keys, key)
            push(sums, int(cells[2]))
            push(counts, 1)
        } else {
            sums[idx] = sums[idx] + int(cells[2])
            counts[idx] = counts[idx] + 1
        }
        i = i + 1
    }
    assert_eq(len(keys), 2)
    assert_eq(keys[0], "eng")
    assert_eq(sums[0], 263)
    assert_eq(counts[0], 3)
    assert_eq(sums[1], 72)
    let scaled = sums[0] * 10 / counts[0]
    assert_eq(str(scaled / 10) + "." + str(scaled - (scaled / 10) * 10), "87.6")
}

func test_where_filter() {
    let rows = "1,88;2,72;3,95;4,61;5,80"
    let rl = split(rows, ";")
    let out = ""
    let n = 0
    let i = 0
    while (i < len(rl)) {
        let cells = split(rl[i], ",")
        if (int(cells[1]) > 65) {
            if (n > 0) { out = out + ";" }
            out = out + rl[i]
            n = n + 1
        }
        i = i + 1
    }
    assert_eq(n, 4)
    assert_eq(out, "1,88;2,72;3,95;5,80")
    assert_eq(len(split(out, ";")), 4)
}

func isqrt_local(n) {
    if (n <= 0) { return 0 }
    let lo = 0
    let hi = n
    let ans = 0
    while (lo <= hi) {
        let mid = (lo + hi) / 2
        let sq = mid * mid
        if (sq == n) { return mid }
        if (sq < n) { ans = mid; lo = mid + 1 } else { hi = mid - 1 }
    }
    return ans
}

func fmt2_local(v) {
    let whole = v / 100
    let frac = v - whole * 100
    let fs = str(frac)
    if (frac < 10) { fs = "0" + fs }
    return str(whole) + "." + fs
}

func test_variance_stddev() {
    let scores = "88,72,95,80"
    let vals = split(scores, ",")
    let n = len(vals)
    let sum = 0
    let i = 0
    while (i < n) {
        sum = sum + int(vals[i])
        i = i + 1
    }
    assert_eq(sum, 335)
    let mean100 = sum * 100 / n
    assert_eq(fmt2_local(mean100), "83.75")
    let d2 = 0
    let k = 0
    while (k < n) {
        let diff = int(vals[k]) * 100 - mean100
        d2 = d2 + diff * diff
        k = k + 1
    }
    assert_eq(d2, 2967500)
    let variance100 = d2 / (n * 100)
    assert_eq(fmt2_local(variance100), "74.18")
    let std100 = isqrt_local(variance100 * 100)
    assert_eq(std100, 861)
    assert_eq(fmt2_local(std100), "8.61")
}
