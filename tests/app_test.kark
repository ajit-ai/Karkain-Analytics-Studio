func test_dataset_record_parse() {
    let rec = "sales|3|3|id,score,units|1,10,5;2,20,6;3,30,7"
    let f = split(rec, "|")
    assert_eq(len(f), 5)
    assert_eq(f[0], "sales")
    assert_eq(int(f[1]), 3)
    assert_eq(split(f[3], ",")[1], "score")
    assert_eq(len(split(f[4], ";")), 3)
}

func test_sum_aggregation() {
    let rows = split("1,10,5;2,20,6;3,30,7", ";")
    let sum = 0
    let i = 0
    while (i < len(rows)) {
        let cells = split(rows[i], ",")
        sum = sum + int(cells[1])
        i = i + 1
    }
    assert_eq(sum, 60)
    let cells2 = split(rows[0], ",")
    assert_eq(int(cells2[2]), 5)
}

func test_avg_one_decimal() {
    let sum = 61
    let count = 3
    let scaled = sum * 10 / count
    let whole = scaled / 10
    let frac = scaled - whole * 10
    assert_eq(whole, 20)
    assert_eq(frac, 3)
    assert_eq(str(whole) + "." + str(frac), "20.3")
}
