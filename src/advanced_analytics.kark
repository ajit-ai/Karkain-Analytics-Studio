// Karkain Analytics Studio - Round 2: grouping, WHERE, statistics, export.
// Dataset record in data/r2_state.dat:
//   name|rows|cols|header|data|view
// Measures use @m|name|op|col|value ; group results use
// @g|name|groupkey|op|col|value . Variance/stddev use integer-scaled math
// (x100) and an integer square root; no floating point builtin is needed.
// No Round 1 files are touched.

func r2_find_dataset(state, name) {
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == name) { return state[i] }
        i = i + 1
    }
    return ""
}

func r2_put_dataset(state, name, rows, cols, header, data, view) {
    let rec = name + "|" + str(rows) + "|" + str(cols) + "|" + header + "|" + data + "|" + view
    let out = []
    let replaced = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == name) { push(out, rec); replaced = 1 } else { push(out, state[i]) }
        i = i + 1
    }
    if (replaced == 0) { push(out, rec) }
    return out
}

func r2_clear_measures(state, name) {
    let out = []
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if ((f[0] == "@m" || f[0] == "@g") && len(f) > 1) {
            if (f[1] != name) { push(out, state[i]) }
        } else {
            push(out, state[i])
        }
        i = i + 1
    }
    return out
}

func r2_put_measure(state, name, op, col, value) {
    let rec = "@m|" + name + "|" + op + "|" + col + "|" + value
    let out = []
    let replaced = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "@m" && f[1] == name && f[2] == op && f[3] == col) { push(out, rec); replaced = 1 } else { push(out, state[i]) }
        i = i + 1
    }
    if (replaced == 0) { push(out, rec) }
    return out
}

func r2_put_group(state, name, key, op, col, value) {
    let rec = "@g|" + name + "|" + key + "|" + op + "|" + col + "|" + value
    let out = []
    let replaced = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "@g" && f[1] == name && f[2] == key && f[3] == op && f[4] == col) { push(out, rec); replaced = 1 } else { push(out, state[i]) }
        i = i + 1
    }
    if (replaced == 0) { push(out, rec) }
    return out
}

func r2_is_int(s) {
    let t = trim(s)
    if (t == "") { return 0 }
    if (str(int(t)) == t) { return 1 }
    return 0
}

func r2_read_dataset(path) {
    let txt = readFile(path)
    if (txt == "") { return "ERR|cannot read" }
    let lines = split(txt, "\n")
    let header = ""
    let cols = 0
    let data = ""
    let n = 0
    let i = 0
    while (i < len(lines)) {
        let line = trim(lines[i])
        if (line != "") {
            if (header == "") {
                header = line
                cols = len(split(line, ","))
            } else {
                let cells = split(line, ",")
                if (len(cells) != cols) { return "ERR|column count mismatch" }
                let row = ""
                let c = 0
                while (c < len(cells)) {
                    if (c > 0) { row = row + "," }
                    row = row + trim(cells[c])
                    c = c + 1
                }
                if (n > 0) { data = data + ";" }
                data = data + row
                n = n + 1
            }
        }
        i = i + 1
    }
    if (n == 0) { return "ERR|no rows" }
    return "OK|" + str(n) + "|" + str(cols) + "|" + header + "|" + data
}

func r2_compare(cell, op, value, numeric) {
    let ok = 0
    if (numeric == 1) {
        let a = int(cell)
        let b = int(value)
        if (op == "EQ") { if (a == b) { ok = 1 } }
        if (op == "NE") { if (a != b) { ok = 1 } }
        if (op == "GT") { if (a > b) { ok = 1 } }
        if (op == "LT") { if (a < b) { ok = 1 } }
        if (op == "GE") { if (a >= b) { ok = 1 } }
        if (op == "LE") { if (a <= b) { ok = 1 } }
    } else {
        if (op == "EQ") { if (cell == value) { ok = 1 } }
        if (op == "NE") { if (cell != value) { ok = 1 } }
        if (op == "GT") { if (cell > value) { ok = 1 } }
        if (op == "LT") { if (cell < value) { ok = 1 } }
        if (op == "GE") { if (cell >= value) { ok = 1 } }
        if (op == "LE") { if (cell <= value) { ok = 1 } }
    }
    return ok
}

func r2_view_rows(rec) {
    let d = split(rec, "|")
    if (d[5] == "EMPTY") { return d[4] }
    return d[5]
}

func r2_fmt2(scaled) {
    let neg = ""
    let v = scaled
    if (v < 0) { neg = "-"; v = 0 - v }
    let whole = v / 100
    let frac = v - whole * 100
    let fs = str(frac)
    if (frac < 10) { fs = "0" + fs }
    return neg + str(whole) + "." + fs
}

func r2_isqrt(n) {
    if (n <= 0) { return 0 }
    let lo = 0
    let hi = n
    let ans = 0
    while (lo <= hi) {
        let mid = (lo + hi) / 2
        let sq = mid * mid
        if (sq == n) { return mid }
        if (sq < n) { ans = mid; lo = mid + 1 } else { hi = mid - 1 }
    }
    return ans
}

func r2_group(state, name, gcolstr, op, mcolstr) {
    let rec = r2_find_dataset(state, name)
    if (rec == "") { print("ERROR unknown dataset " + name); return state }
    let source = r2_view_rows(rec)
    let gcol = int(gcolstr)
    let mcol = int(mcolstr)
    let keys = []
    let sums = []
    let counts = []
    let rows = split(source, ";")
    let i = 0
    while (i < len(rows)) {
        let cells = split(rows[i], ",")
        if (gcol < len(cells) && mcol < len(cells)) {
            let key = cells[gcol]
            let idx = -1
            let k = 0
            while (k < len(keys)) {
                if (keys[k] == key) { idx = k }
                k = k + 1
            }
            if (idx == -1) {
                push(keys, key)
                push(sums, int(cells[mcol]))
                push(counts, 1)
            } else {
                sums[idx] = sums[idx] + int(cells[mcol])
                counts[idx] = counts[idx] + 1
            }
        }
        i = i + 1
    }
    let g = 0
    while (g < len(keys)) {
        let value = ""
        if (op == "SUM") { value = str(sums[g]) }
        if (op == "COUNT") { value = str(counts[g]) }
        if (op == "AVG") {
            let c = counts[g]
            if (c == 0) { c = 1 }
            let scaled = sums[g] * 10 / c
            let whole = scaled / 10
            let frac = scaled - whole * 10
            value = str(whole) + "." + str(frac)
        }
        state = r2_put_group(state, name, keys[g], op, mcolstr, value)
        print("GROW " + name + " " + keys[g] + " " + op + "=" + value)
        g = g + 1
    }
    print("GROUP " + name + " by=" + gcolstr + " op=" + op + " measure=" + mcolstr + " groups=" + str(len(keys)))
    return state
}

func r2_stats(state, name, colstr) {
    let rec = r2_find_dataset(state, name)
    if (rec == "") { print("ERROR unknown dataset " + name); return state }
    let source = r2_view_rows(rec)
    let col = int(colstr)
    let rows = split(source, ";")
    let n = 0
    let sum = 0
    let i = 0
    while (i < len(rows)) {
        let cells = split(rows[i], ",")
        if (col < len(cells)) { sum = sum + int(cells[col]); n = n + 1 }
        i = i + 1
    }
    if (n == 0) { print("STATS " + name + " rows=0"); return state }
    let mean100 = sum * 100 / n
    let d2sum = 0
    let k = 0
    while (k < len(rows)) {
        let cells = split(rows[k], ",")
        if (col < len(cells)) {
            let diff = int(cells[col]) * 100 - mean100
            d2sum = d2sum + diff * diff
        }
        k = k + 1
    }
    let variance100 = d2sum / (n * 100)
    let std100 = r2_isqrt(variance100 * 100)
    let ms = r2_fmt2(mean100)
    let vs = r2_fmt2(variance100)
    let ss = r2_fmt2(std100)
    state = r2_put_measure(state, name, "MEAN", colstr, ms)
    state = r2_put_measure(state, name, "VAR", colstr, vs)
    state = r2_put_measure(state, name, "STD", colstr, ss)
    print("STATS " + name + " col=" + colstr + " rows=" + str(n) + " mean=" + ms + " variance=" + vs + " stddev=" + ss)
    return state
}

func r2_report_export(state, name, path) {
    let rec = r2_find_dataset(state, name)
    if (rec == "") { print("ERROR unknown dataset " + name); return }
    let d = split(rec, "|")
    let text = "REPORT " + name + "\n"
    text = text + "DATASET " + name + " rows=" + d[1] + " cols=" + d[2] + " header=" + d[3] + "\n"
    text = text + "VIEW rows=" + str(len(split(r2_view_rows(rec), ";"))) + "\n"
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "@m" && f[1] == name) {
            text = text + "MEASURE " + f[2] + " col=" + f[3] + " value=" + f[4] + "\n"
        }
        i = i + 1
    }
    i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "@g" && f[1] == name) {
            text = text + "GROUP " + f[2] + " " + f[3] + " col=" + f[4] + " value=" + f[5] + "\n"
        }
        i = i + 1
    }
    text = text + "REPORT_END " + name + "\n"
    writeFile(path, text)
    print("REPORT_EXPORT " + name + " -> " + path + " lines=" + str(len(split(text, "\n"))))
}

func r2_persist(path, lines) {
    let out = ""
    let i = 0
    while (i < len(lines)) {
        out = out + lines[i] + "\n"
        i = i + 1
    }
    writeFile(path, out)
}

public func r2_run() {
    let cmds = split(readFile("data/r2_commands.dat"), "\n")
    let state = split(readFile("data/r2_state.dat"), "\n")
    if (len(state) == 1) {
        if (trim(state[0]) == "") { state = [] }
    }
    let report = ""
    let i = 0
    while (i < len(cmds)) {
        let line = trim(cmds[i])
        if (line != "") {
            let f = split(line, "|")
            let op = f[0]
            if (op == "LOAD2") {
                let res = r2_read_dataset(f[2])
                let p = split(res, "|")
                if (p[0] == "ERR") {
                    let msg = "LOAD_ERR " + f[1] + " reason=" + p[1]
                    print(msg)
                    report = report + msg + "\n"
                } else {
                    state = r2_clear_measures(state, f[1])
                    state = r2_put_dataset(state, f[1], int(p[1]), int(p[2]), p[3], p[4], p[4])
                    let msg = "LOAD2 " + f[1] + " rows=" + p[1] + " cols=" + p[2]
                    print(msg)
                    report = report + msg + "\n"
                }
            }
            if (op == "WHERE") {
                let rec = r2_find_dataset(state, f[1])
                if (rec == "") {
                    print("ERROR unknown dataset " + f[1])
                } else {
                    let d = split(rec, "|")
                    let col = int(f[2])
                    let value = f[4]
                    let numeric = r2_is_int(value)
                    let rows = split(d[4], ";")
                    let k = 0
                    while (k < len(rows)) {
                        let cells = split(rows[k], ",")
                        if (col < len(cells)) {
                            if (r2_is_int(cells[col]) == 0) { numeric = 0 }
                        }
                        k = k + 1
                    }
                    let view = ""
                    let matched = 0
                    let r = 0
                    while (r < len(rows)) {
                        let cells = split(rows[r], ",")
                        if (col < len(cells)) {
                            if (r2_compare(cells[col], f[3], value, numeric) == 1) {
                                if (matched > 0) { view = view + ";" }
                                view = view + rows[r]
                                matched = matched + 1
                            }
                        }
                        r = r + 1
                    }
                    if (matched == 0) { view = "EMPTY" }
                    state = r2_put_dataset(state, f[1], int(d[1]), int(d[2]), d[3], d[4], view)
                    let msg = "WHERE " + f[1] + " col=" + f[2] + " op=" + f[3] + " value=" + value + " matched=" + str(matched)
                    print(msg)
                    report = report + msg + "\n"
                }
            }
            if (op == "GROUP") {
                state = r2_group(state, f[1], f[2], f[3], f[4])
                report = report + "GROUP " + f[1] + " by=" + f[2] + " op=" + f[3] + " measure=" + f[4] + "\n"
            }
            if (op == "STATS") {
                state = r2_stats(state, f[1], f[2])
                report = report + "STATS " + f[1] + " col=" + f[2] + "\n"
            }
            if (op == "REPORT_EXPORT") {
                r2_report_export(state, f[1], f[2])
                report = report + "REPORT_EXPORT " + f[1] + " -> " + f[2] + "\n"
            }
        }
        i = i + 1
    }
    r2_persist("data/r2_state.dat", state)
    r2_persist("data/r2_report.dat", split(report, "\n"))
    print("R2_ANALYTICS_OK datasets=" + str(len(state)))
}
